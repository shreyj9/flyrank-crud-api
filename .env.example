# Copy this file to .env before starting the stack.
# Replace the Supabase placeholders with your project's public URL and anon/publishable key.
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks
API_PORT=8000
DATABASE_URL=postgresql://taskuser:change-me@db:5432/tasks
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
